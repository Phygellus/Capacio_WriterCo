@page "/dashboard"
@using WriterCo.Components.Layout
@layout SignedLayout
@inject NavigationManager Navigation
@inject Supabase.Client Db
@inject UserSession Session

<div class="dashboard-container">
    <div class="document-grid">
        
        <div class="doc-item" @onclick="CreateNewDocument">
            <div class="doc-thumbnail new-doc">
                <span class="plus-icon">+</span>
            </div>
            <span class="doc-title">New</span>
        </div>

        @if (isLoading)
        {
            <p style="color: #888;">Loading documents...</p>
        }
        else
        {
            @foreach (var doc in userDocuments)
            {
                <div class="doc-item" @onclick="() => OpenDocument(doc.Id)">
                    <div class="doc-thumbnail"></div>
                    <span class="doc-title">@doc.Title</span>
                </div>
            }
        }
    </div>
</div>

@code {
    private List<DocumentModel> userDocuments = new();
    private bool isLoading = true;
    private bool isCreating = false; 

    protected override async Task OnInitializedAsync()
    {
        await LoadDocuments();
    }

private async Task LoadDocuments()
{
    isLoading = true;
    try
    {
        var currentUserId = Session.CurrentUser?.Id ?? 0;
        
        var response = await Db.From<DocumentModel>()
            .Where(d => d.DeletedAt == null)
            .Where(d => d.OwnerId == currentUserId)
            .Order(d => d.Id, Supabase.Postgrest.Constants.Ordering.Descending)
            .Get();
            
        userDocuments = response.Models;
    }
    catch (Exception ex)
    {
        // This will print the exact Postgres error to your terminal
        Console.WriteLine("=== ERROR LOADING DOCUMENTS ===");
        Console.WriteLine(ex.Message);
        Console.WriteLine("===============================");
    }
    finally
    {
        isLoading = false;
    }
}
    private async Task CreateNewDocument()
    {
        if (isCreating) return; 
        isCreating = true;

        try
        {
            if (Session.CurrentUser == null)
            {
                Navigation.NavigateTo("/login");
                return;
            }

            var newDoc = new DocumentModel
            {
                Title = "Untitled",
                OwnerId = Session.CurrentUser.Id // <--- Use the Session ID
            };

            var response = await Db.From<DocumentModel>().Insert(newDoc);
            var createdDoc = response.Models.FirstOrDefault();
            
            if (createdDoc != null)
            {
                Navigation.NavigateTo($"/document?id={createdDoc.Id}");
            }
        }
        finally
        {
            isCreating = false;
        }
    }

    private void OpenDocument(long id)
    {
        Navigation.NavigateTo($"/document?id={id}"); 
    }
}