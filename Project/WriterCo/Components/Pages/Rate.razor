@page "/rate"
@using WriterCo.Components.Layout
@layout MainNewLayout
@inject Supabase.Client Db

<div class="rating-container">
    <h2>Rate Our Website!</h2>

    <div class="stars">
        @for (int i = 1; i <= 5; i++)
        {
            var starValue = i; 
            <span class="star @(starValue <= currentRating ? "filled" : "")" 
                  @onclick="() => SetRating(starValue)">
                ★
            </span>
        }
    </div>

    <div class="comment-section">
        <label>Comments:</label>
        <textarea @bind="commentText" placeholder="Tell us what you think..." rows="4"></textarea>
    </div>

    <div class="action-section">
        <!-- Slide 50: Disable button while posting -->
        <button class="post-btn" @onclick="SubmitReview" disabled="@isPosting">
            @(isPosting ? "Posting..." : "Post")
        </button>
    </div>

    @if (showSuccessMessage)
    {
        <div class="success-message">Thank you! Your review has been posted.</div>
    }

    @if (reviews.Any())
    {
        <div class="reviews-list">
            <h3>Recent Feedback</h3>
            @foreach (var review in reviews)
            {
                <div class="review-item">
                    <div class="review-stars">
                        @for (int i = 1; i <= 5; i++)
                        {
                            <span class="star-small @(i <= review.Rating ? "filled" : "")">★</span>
                        }
                    </div>
                    <p class="review-text">@review.Comment</p>
                </div>
            }
        </div>
    }
</div>

@code {
    private int currentRating = 0;
    private string commentText = "";
    private bool showSuccessMessage = false;
    private bool isPosting = false;

    private List<Review> reviews = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadReviews();
    }

    private async Task LoadReviews()
    {
        // Slide 49: Fetch from DB where DeletedAt is null
        var response = await Db.From<Review>()
            .Where(r => r.DeletedAt == null)
            .Order(r => r.Id, Supabase.Postgrest.Constants.Ordering.Descending)
            .Get();
            
        reviews = response.Models;
    }

    private void SetRating(int rating)
    {
        currentRating = rating;
        showSuccessMessage = false; 
    }

    private async Task SubmitReview()
    {
        if (currentRating == 0 || isPosting) return;
        isPosting = true;

        try
        {
            var newReview = new Review
            {
                Rating = currentRating,
                Comment = commentText,
                UserId = 1 // Hardcoded until you add Auth
            };
            
            // Slide 50: Send POST request
            await Db.From<Review>().Insert(newReview);

            showSuccessMessage = true;
            currentRating = 0;
            commentText = "";
            
            // Reload the list to show the new review
            await LoadReviews();
        }
        finally
        {
            isPosting = false;
        }
    }
}