@page "/document"
@using WriterCo.Components.Layout
@layout SignedLayout
@inject NavigationManager Navigation
@inject Supabase.Client Db

<div class="editor-layout">
    <div class="sidebar">
        <div class="menu-container">
            <button class="icon-btn hamburger" @onclick="ToggleMenu">&#9776;</button>
            
            @if (isMenuOpen)
            {
                <div class="dropdown-menu">
                    <button @onclick='() => Navigation.NavigateTo("/dashboard")'>Back to Dashboard</button>
                    <button @onclick="async () => await SaveFile()" disabled="@isSaving">
                        @(isSaving ? "Saving..." : "Save")
                    </button>
                    <button @onclick="async () => await SoftDeleteFile()">Delete</button>
                </div>
            }
        </div>

        <div class="outline-panel">
            @foreach (var heading in currentHeadings)
            {
                <div class="outline-item">@heading</div>
            }
            
            <!-- Input to add new headings -->
            <div class="outline-item" style="margin-top: 10px;">
                <input @bind="newHeadingInput" @onkeydown="AddHeading" placeholder="+ Add Heading" class="heading-input" />
            </div>
        </div>
    </div> 

    <div class="editor-main">
        <!-- Google Docs Style Toolbar -->
        <div class="toolbar">
            <!-- Title Input on the left -->
            <input class="doc-title-input" @bind="currentDocument.Title" placeholder="Untitled Document" />
            
            <!-- Formatting Buttons on the right -->
            <div class="format-buttons">
                <button class="tool-btn">B</button>
                <button class="tool-btn"><i>I</i></button>
                <button class="tool-btn"><u>U</u></button>
            </div>
        </div>

        <div class="paper-container">
            <textarea class="paper" @bind="currentPageBody" placeholder="Start writing..."></textarea>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    public long? Id { get; set; } 

    private bool isMenuOpen = false;
    private bool isSaving = false;
    
    private DocumentModel currentDocument = new();
    private string currentPageBody = string.Empty;
    
    // Lists for the outline panel
    private List<string> currentHeadings = new();
    private string newHeadingInput = "";

    protected override async Task OnInitializedAsync()
    {
        if (Id.HasValue)
        {
            await LoadDocument(Id.Value);
        }
    }

    private async Task LoadDocument(long id)
    {
        var response = await Db.From<DocumentModel>()
            .Where(d => d.Id == id)
            .Single(); 

        if (response != null)
        {
            currentDocument = response;
            
            // Load the text body
            var firstPage = currentDocument.GetPages().FirstOrDefault();
            currentPageBody = firstPage?.Body ?? string.Empty;
            
            // Load the headings
            currentHeadings = currentDocument.GetHeadings();
        }
    }

    private void ToggleMenu() => isMenuOpen = !isMenuOpen;

    // Adds a heading to the list when the user presses Enter
    private void AddHeading(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(newHeadingInput))
        {
            currentHeadings.Add(newHeadingInput);
            newHeadingInput = ""; // Clear input
        }
    }

    private async Task SaveFile()
    {
        if (isSaving) return; 
        isSaving = true;

        try
        {
            // 1. Save the Page Body
            var pages = currentDocument.GetPages();
            if (pages.Any())
            {
                pages[0].Body = currentPageBody;
            }
            else
            {
                pages.Add(new Page(currentPageBody));
            }
            currentDocument.SetPages(pages);

            // 2. Save the Headings
            currentDocument.SetHeadings(currentHeadings);

            // 3. Update Supabase
            await Db.From<DocumentModel>()
                .Where(d => d.Id == currentDocument.Id)
                .Set(d => d.Title, currentDocument.Title)
                .Set(d => d.ContentJson, currentDocument.ContentJson)
                .Update();
                
            Console.WriteLine("Saved successfully!");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving: {ex.Message}");
        }
        finally
        {
            isSaving = false;
            isMenuOpen = false;
        }
    }

    private async Task SoftDeleteFile()
    {
        if (currentDocument.Id == 0) return;

        await Db.From<DocumentModel>()
            .Where(d => d.Id == currentDocument.Id)
            .Set(d => d.DeletedAt, DateTime.UtcNow)
            .Update();

        Navigation.NavigateTo("/dashboard");
    }
}