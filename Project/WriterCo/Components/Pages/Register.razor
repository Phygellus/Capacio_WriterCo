@page "/register"
@using WriterCo.Components.Layout
@layout AuthLayout
@inject NavigationManager Navigation
@inject Supabase.Client Db
@inject UserSession Session

<div class="auth-form">
    <input type="text" class="auth-input" placeholder="Enter Username" @bind="username" />
    <input type="email" class="auth-input" placeholder="Enter Email" @bind="email" />
    <input type="password" class="auth-input" placeholder="Enter Password" @bind="password" />

    <button class="auth-btn" @onclick="SignUp" disabled="@isLoading">
        @(isLoading ? "Signing up..." : "Sign Up")
    </button>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <p style="color: #ff4444; font-size: 14px; margin-top: 10px; text-align: center;">@errorMessage</p>
    }

    <p class="auth-footer">
        Already have an account? <span @onclick="GoToLogin" class="nav-link">Log In</span>
    </p>
</div>

@code {
    private string username = "";
    private string email = "";
    private string password = "";
    private bool isLoading = false;
    private string errorMessage = "";

    private void GoToLogin() => Navigation.NavigateTo("/login");

    private async Task SignUp()
    {
        if (string.IsNullOrWhiteSpace(username) || string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(password))
        {
            errorMessage = "Please fill in all fields.";
            return;
        }

        isLoading = true;
        errorMessage = "";

        try
        {
            var existingUsers = await Db.From<User>().Where(u => u.Email == email).Get();
            if (existingUsers.Models.Count > 0)
            {
                errorMessage = "Email is already registered. Try logging in.";
                return;
            }

            var newUser = new User
            {
                Username = username,
                Email = email,
                Password = password
            };

            // Insert returns the newly created model (including the auto-generated ID!)
            var response = await Db.From<User>().Insert(newUser);
            var createdUser = response.Models.FirstOrDefault();

            if (createdUser != null)
            {
                Session.LogIn(createdUser); // Save to Session
                Navigation.NavigateTo("/dashboard");
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Registration failed.";
            Console.WriteLine(ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }
}