@inherits LayoutComponentBase
@inject NavigationManager Navigation

<div class="main-layout">
    <header class="navbar">
        <a href="/" class="logo">Writer Co.</a>
        <nav>
            <button @onclick="GoToLogin" class="nav-btn">
                Sign In
            </button>

            <button @onclick="GoToRegister" class="nav-btn">
                Sign Up
            </button>        
        </nav>
    </header>
    
    <main class="content">
        @Body
    </main>
</div>

@code {
    private void GoToLogin()
    {
        Navigation.NavigateTo("/login");
    }

    private void GoToRegister()
    {
        Navigation.NavigateTo("/register");
    }
}